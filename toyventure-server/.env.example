NODE_ENV=production
PORT=5000
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/toyblix?retryWrites=true&w=majority
JWT_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-a-second-long-random-secret
CLIENT_URL=https://toyblix.com
CORS_ORIGIN=https://toyblix.com,https://www.toyblix.com
TRUST_PROXY=true
REQUEST_SIZE_LIMIT=1mb
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=replace-with-razorpay-secret
RAZORPAY_WEBHOOK_SECRET=replace-with-webhook-secret
OTP_PROVIDER=msg91
OTP_API_KEY=replace-with-otp-provider-key
OTP_SENDER_ID=TVTOTP
OTP_SECRET=replace-with-otp-hash-secret
OTP_TTL_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=45
REDIS_URL=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
